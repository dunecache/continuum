<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="nav_header_vertical_spacing">8dp</dimen>
    <dimen name="nav_header_height">176dp</dimen>
    <dimen name="fab_margin">16dp</dimen>
    <!-- Bottom clearance so the last list item can scroll clear of a bottom|end FAB
         (FAB 56dp + fab_margin 16dp + 16dp breathing room). -->
    <dimen name="fab_clearance">88dp</dimen>
    <dimen name="roundedBottomSheetCornerRadiusLeftPadding">0dp</dimen>
    <dimen name="roundedBottomSheetCornerRadiusRightPadding">0dp</dimen>
    <dimen name="staggeredLayoutManagerItemOffset">16dp</dimen>
    <dimen name="mtrl_slider_track_side_padding">2dp</dimen>
    <!-- Square thumbnail box in the compact/card-2 post layouts. Read by both the layouts and
         PostRecyclerViewAdapter so the picked Reddit preview resolution matches the rendered
         size at the device's density (override per screen-size qualifier if ever needed). -->
    <dimen name="post_compact_thumbnail_size">112dp</dimen>
    <!-- The subreddit icon in the Shadowbox info panel. -->
    <dimen name="shadowbox_panel_icon_size">24dp</dimen>
    <!-- Width the comment score column is given when the toolbar has room for it, matching
         upstream Infinity's fixed 64dp column: the arrows then sit the same distance apart
         whether the score reads "6" or "11356". It is a minimum, not a width, and CommentToolbar
         gives it up as its first compaction step, so a row that cannot afford it falls back to
         the score's own width rather than dropping a button. Override per screen-size qualifier
         if a wider column is ever wanted on tablets. -->
    <dimen name="comment_score_min_width">64dp</dimen>

    <dimen name="space_2">2dp</dimen>
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_32">32dp</dimen>

    <dimen name="touch_target_min">48dp</dimen>
    <dimen name="signal_rail_width">2dp</dimen>
    <dimen name="shape_corner_small">8dp</dimen>
    <dimen name="shape_corner_medium">12dp</dimen>
    <dimen name="shape_corner_large">16dp</dimen>
    <dimen name="shape_corner_sheet">28dp</dimen>
    <dimen name="divider_thickness">1dp</dimen>
    <dimen name="navigation_item_min_height">64dp</dimen>
    <dimen name="feed_bottom_navigation_clearance">64dp</dimen>
    <dimen name="feed_tab_height">48dp</dimen>
    <!--
         Zero on purpose. A scrollable TabLayout gives every tab a 72dp minimum width unless told
         otherwise, which would floor the selected tab's pill at 72dp whatever the label says: "All"
         would get a lozenge twice its own width, and every label in the strip would carry the same
         oversized pill. The pill is sized by its label plus the strip's tab padding instead.
    -->
    <dimen name="feed_tab_min_width">0dp</dimen>
    <dimen name="community_banner_height">160dp</dimen>
    <dimen name="navigation_icon_size">24dp</dimen>
    <dimen name="navigation_indicator_width">64dp</dimen>
    <dimen name="navigation_indicator_height">32dp</dimen>
    <dimen name="domain_chip_min_height">32dp</dimen>
    <dimen name="domain_chip_padding_horizontal">12dp</dimen>
    <dimen name="domain_chip_icon_size">16dp</dimen>
    <dimen name="feed_state_icon_size">48dp</dimen>
    <dimen name="content_max_width">720dp</dimen>

    <!--
         Motion. Phase 0 asked for duration/easing tokens "even if unused yet" and never wrote them,
         so the two chrome bars had nothing to agree on: the tab pill, the bottom bar's item
         selection and every sheet ran on whatever each Material component happened to default to.

         These are Material 3's own three emphasis tiers, not invented numbers. M3 names them
         short/medium/long at 100/200/300ms, which is also the 150-250ms band AGENTS.md asks for
         read as "the two tiers a state change should use" - the long tier is for motion that
         travels rather than for a selection. Deliberately the same numbers Material's components
         already animate at, so pointing a component at a token changes nothing about its timing
         unless the token itself moves; that is what makes it a token rather than a second opinion.

         Easing is deliberately absent: Material 3's standard curve is an interpolator resource
         inside the library, and a hand-written approximation of it would be a copy that silently
         stops matching. Reach for @android:interpolator/fast_out_slow_in only if a duration alone
         proves insufficient, and name the curve when it does.

         UnusedResources is suppressed on each of these rather than added to lint-baseline.xml, and
         the reason is worth stating: the check is correct, the tokens are genuinely unreferenced,
         and every piece of motion in the shell today is Material's own - the tab indicator, the
         popup, the app bar scroll - none of which exposes a duration attribute to point a token
         at. Suppressed here so the intent survives the baseline being regenerated wholesale by
         lint.yml, and so the definition site says why. The first hand-rolled animation in the
         shell is what should consume them, and it should drop this suppression when it does.
    -->
    <dimen name="motion_duration_short" tools:ignore="UnusedResources">100ms</dimen>
    <dimen name="motion_duration_medium" tools:ignore="UnusedResources">200ms</dimen>
    <dimen name="motion_duration_long" tools:ignore="UnusedResources">300ms</dimen>
</resources>
