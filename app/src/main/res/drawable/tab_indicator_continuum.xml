<?xml version="1.0" encoding="utf-8"?>
<!--
  The selected tab's indicator: the same pill the selected destination gets at the bottom of the
  screen, so the two read as one system rather than two designs that happen to be on the same screen.

  Inset rather than sized because the tab row is a fixed 48dp and an indicator that stretches the
  full height reads as a block, not a pill. 48dp less 8dp either side is the 32dp the bottom bar's
  active indicator is, reached from the spacing scale rather than by copying the number: move
  navigation_indicator_height and this one has to be revisited, which is the point of writing it down.

  The four directional insets rather than insetHorizontal/insetVertical, which are API 26 and this
  app supports 24.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/space_12"
    android:insetRight="@dimen/space_12"
    android:insetTop="@dimen/space_8"
    android:insetBottom="@dimen/space_8">
    <shape android:shape="rectangle">
        <solid android:color="?attr/colorSecondaryContainer" />
        <corners android:radius="@dimen/shape_corner_large" />
    </shape>
</inset>
